{
  "name": "travelpoint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build && node scripts/copy-images.js",
    "preview": "vite preview",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:setup": "node server/setup.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "kysely": "^0.29.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
